+        candidates = [span for span in parsed if span[0] <= target <= span[1]]
+        if candidates:
+            first, last, name = min(candidates, key=lambda s: (s[1] - s[0], -s[0]))
+            return first, last, "\n".join(lines[first - 1:last]), "full_file_ast", name
