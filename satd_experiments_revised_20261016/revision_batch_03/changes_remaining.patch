+def quantile(values, probability):
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * probability
+    low = int(index)
+    high = min(low + 1, len(ordered) - 1)
+    return ordered[low] + (index - low) * (ordered[high] - ordered[low])
+
